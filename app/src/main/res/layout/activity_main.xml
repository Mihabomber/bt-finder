<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:orientation="vertical" android:gravity="center"
  android:padding="24dp" android:layout_width="match_parent" android:layout_height="match_parent">
  <TextView android:id="@+id/tvStatus" android:text="Нажми СТАРТ" android:textSize="20sp"
    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  <TextView android:id="@+id/tvDist" android:text="Дистанция: —" android:textSize="32sp"
    android:layout_marginTop="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  <TextView android:id="@+id/tvRssi" android:text="RSSI: —" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  <EditText android:id="@+id/etTarget" android:hint="Имя BT потерянного телефона (например Pixel)"
    android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <Button android:id="@+id/btnToggle" android:text="ВКЛЮЧИТЬ ПОИСК"
    android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <TextView android:text="Подсказка: на потерянном телефоне включи Bluetooth (видимость). Чем ближе — тем меньше метров."
    android:layout_marginTop="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
